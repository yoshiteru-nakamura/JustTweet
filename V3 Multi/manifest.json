{
  "manifest_version": 3,
  "name": "Multi-SNS Share Extension",
  "version": "3.0",
  "default_locale": "en",
  "description": "Share pages to X, Threads, and Bluesky at once.",
  "icons": {
    "16": "icon_16.png",
    "128": "icon_128.png"
  },
  "action": {
    "default_icon": "icon_16.png",
    "default_title": "Share Link",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "option.html",
  "permissions": [
    "tabs",
    "storage"
  ]
}